# Copy this file to .env.local and add the values from your Supabase project.
# The publishable key is safe for browser use when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Defaults to http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
